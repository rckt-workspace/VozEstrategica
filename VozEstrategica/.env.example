# ============================================================
# SUPABASE CONFIGURATION
# ============================================================

# Server-side only (DO NOT PREFIX WITH VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (can be prefixed with VITE_)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# ============================================================
# LLM PROVIDER (OPENROUTER)
# ============================================================

# API key (server-side only, NEVER expose to client)
OPENROUTER_API_KEY=

# API configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model selection
CHAT_PRIMARY_LLM=openrouter/free

# Model parameters
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=900

# ============================================================
# PAYMENT & THIRD-PARTY SERVICES
# ============================================================

BOLD_IDENTITY_KEY=

# ============================================================
# ADMIN AUTHENTICATION (INSTITUTIONAL PASSWORD)
# ============================================================

# Institutional admin password (server-side validation only)
# Used by POST /api/admin/session for institutional login
# NEVER send to client, NEVER use in frontend
ADMIN_CONTROL_SECRET=

# Session signing secret for institutional admin sessions
# Used to sign/verify admin session tokens
# MUST be different from ADMIN_CONTROL_SECRET
# NEVER expose to client
ADMIN_SESSION_SECRET=

# ============================================================
# INTERNAL OPERATIONS
# ============================================================

# Reserved for future server-to-server authenticated operations
# NEVER expose to client or use in browser context
RCKT_INTERNAL_SECRET=

# ============================================================
# ANALYTICS (FUTURE)
# ============================================================

# GA4 Property ID (when Data API integration is ready)
# GA4_PROPERTY_ID=

# Google Ads Customer ID (when API integration is ready)
# GOOGLE_ADS_CUSTOMER_ID=
